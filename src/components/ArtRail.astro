---
import { Image } from 'astro:assets';
import { artistPayload, type ArtEntry } from '../lib/art';

interface Props {
  pieces: ArtEntry[];
  counts: Map<string, number>;
}

const { pieces, counts } = Astro.props;

const countFor = (name?: string) => counts.get((name ?? '').trim().toLowerCase()) ?? 1;
---

<section
  class="arail"
  id="art"
  data-loc="ART"
  aria-labelledby="arail-h"
>
  <div class="arail__frame">
    <div class="arail__head">
      <div class="arail__lede">
        <h2 class="arail__h" id="arail-h">Art</h2>
        <p class="arail__line">Monumei, drawn by commissioned artists and sometimes by me.</p>
      </div>

      <a class="btn btn--ghost arail__all" href="/art/">
        {pieces.length > 1 ? `All ${pieces.length} pieces` : 'See the gallery'}
      </a>
    </div>

    <div class="arail__viewport" data-art-viewport tabindex="0" aria-label="Art preview">
      <ul class="arail__track">
        {
          pieces.map((entry, index) => {
            const d = entry.data;
            const credited = !!d.artist;
            const hasCard = credited && d.artistLinks.length > 0;
            const label = d.artistHandle || d.artist || '';
            return (
              <li class="cell" data-art-cell data-index={index}>
                <a class="cell__link brackets" href="/art/">
                  <Image
                    src={d.image}
                    alt={d.alt}
                    widths={[420, 700, 1000]}
                    sizes="(max-width: 860px) 72vw, 34vw"
                    loading="lazy"
                  />
                  <span class="cell__rule" aria-hidden="true" />
                </a>

                <div class="cell__cap">
                  <span class="cell__title">{d.title}</span>

                  {credited &&
                    (hasCard ? (
                      <button
                        class="cell__credit data"
                        type="button"
                        data-artist={artistPayload(d, countFor(d.artist))}
                      >
                        {label}
                      </button>
                    ) : (
                      <span class="cell__credit cell__credit--flat data">{label}</span>
                    ))}

                  {d.creditPending && <span class="cell__pending data">Credit pending</span>}
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>

    {
      pieces.length > 1 && (
        <div class="arail__progress" data-art-progress>
          <div class="arail__dots" aria-hidden="true">
            {pieces.map((_, index) => (
              <span class="arail__dot" data-art-dot data-active={index === 0 ? '' : undefined} />
            ))}
          </div>
          <span class="sr-only" data-art-status aria-live="polite">
            Piece 1 of {pieces.length}
          </span>
        </div>
      )
    }
  </div>
</section>

<style>
  .arail {
    --pad: max(var(--gutter), calc((100vw - var(--rail)) / 2));
    --cell-h: clamp(260px, 50vh, 460px);
    position: relative;
    background: var(--chassis-0);
  }

  .arail__frame {
    padding-block: clamp(68px, 10svh, var(--s9));
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 4vh, 44px);
  }

  .arail__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s5);
    flex-wrap: wrap;
    padding-inline: var(--pad);
  }

  .arail__h {
    font-size: clamp(1.85rem, 4.4vw, 3.1rem);
    font-weight: 600;
  }

  .arail__line {
    max-width: 34ch;
    margin-block-start: var(--s3);
    font-size: clamp(0.95rem, 1.4vw, 1.0625rem);
    line-height: 1.6;
    color: var(--ink-3);
  }

  .arail__all {
    flex: none;
  }

  .arail__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--pad);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    padding-block-end: var(--s2);
  }

  .arail__viewport::-webkit-scrollbar {
    display: none;
  }

  .arail__track {
    display: flex;
    align-items: flex-start;
    gap: var(--s4);
    width: max-content;
    padding: 0;
    padding-inline: var(--pad);
    margin: 0;
    list-style: none;
  }

  .cell {
    display: flex;
    flex-direction: column;
    flex: none;
    scroll-snap-align: start;
  }

  .cell__link {
    --notch: var(--notch-m);
    position: relative;
    display: block;
    height: var(--cell-h);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--chassis-1);
    border: 1px solid var(--seam);
    clip-path: polygon(
      0 0,
      calc(100% - var(--notch)) 0,
      100% var(--notch),
      100% 100%,
      var(--notch) 100%,
      0 calc(100% - var(--notch))
    );
    transition: border-color var(--t-base) var(--ease-snap);
  }

  .cell__link :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
    transition: transform var(--t-slow) var(--ease-power);
  }

  .cell__link:hover,
  .cell__link:focus-visible {
    border-color: rgb(46 123 255 / 0.5);
  }

  .cell__link:hover :global(img),
  .cell__link:focus-visible :global(img) {
    transform: scale(1.04);
  }

  .cell__link::before,
  .cell__link::after {
    z-index: 1;
    opacity: 0;
    transition: opacity var(--t-base) var(--ease-snap);
  }

  .cell__link:hover::before,
  .cell__link:hover::after,
  .cell__link:focus-visible::before,
  .cell__link:focus-visible::after {
    opacity: 0.85;
  }

  .cell__rule {
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: linear-gradient(90deg, var(--led), var(--led-hot));
    box-shadow: var(--emit-led);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-slow) var(--ease-power);
  }

  .cell__link:hover .cell__rule,
  .cell__link:focus-visible .cell__rule {
    transform: scaleX(1);
  }

  .cell__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2) var(--s3);
    padding-block-start: var(--s3);
    max-width: 42ch;
  }

  .cell__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--ink);
  }

  .cell__credit {
    padding: 0;
    font-size: 0.6875rem;
    color: var(--sig);
    border-bottom: 1px solid rgb(255 212 41 / 0.4);
    transition: border-color var(--t-fast) var(--ease-snap);
  }

  .cell__credit:hover,
  .cell__credit:focus-visible {
    border-bottom-color: var(--sig);
  }

  .cell__credit--flat {
    border-bottom: none;
  }

  .cell__pending {
    font-size: 0.625rem;
    color: var(--warn);
    background: rgb(255 165 2 / 0.1);
    border: 1px solid rgb(255 165 2 / 0.3);
    padding: 2px 7px;
  }

  .arail__progress {
    display: flex;
    justify-content: center;
    padding-inline: var(--pad);
  }

  .arail__dots {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 20px;
  }

  .arail__dot {
    width: 5px;
    height: 5px;
    background: var(--chassis-4);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
    transition:
      width var(--t-fast) var(--ease-snap),
      background var(--t-fast) var(--ease-snap),
      box-shadow var(--t-fast) var(--ease-snap);
  }

  .arail__dot[data-active] {
    width: 18px;
    background: var(--led);
    box-shadow: var(--emit-led);
    clip-path: none;
  }

  @media (max-width: 860px) {
    .arail {
      --cell-h: clamp(240px, 58svh, 420px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cell__link:hover :global(img),
    .cell__link:focus-visible :global(img) {
      transform: none;
    }

    .arail__dot {
      transition-duration: 1ms;
    }
  }
</style>

<script>
  const init = () => {
    for (const viewport of document.querySelectorAll<HTMLElement>('[data-art-viewport]')) {
      if (viewport.dataset.artReady === '') continue;
      viewport.dataset.artReady = '';

      const rail = viewport.closest<HTMLElement>('.arail');
      const cells = [...viewport.querySelectorAll<HTMLElement>('[data-art-cell]')];
      const dots = [...(rail?.querySelectorAll<HTMLElement>('[data-art-dot]') ?? [])];
      const status = rail?.querySelector<HTMLElement>('[data-art-status]');
      let queued = false;

      const updatePosition = () => {
        queued = false;
        let active = 0;
        let distance = Infinity;

        for (const [index, cell] of cells.entries()) {
          const next = Math.abs(cell.offsetLeft - viewport.scrollLeft);
          if (next < distance) {
            active = index;
            distance = next;
          }
        }

        dots.forEach((dot, index) => dot.toggleAttribute('data-active', index === active));
        if (status) status.textContent = `Piece ${active + 1} of ${cells.length}`;
      };

      viewport.addEventListener(
        'scroll',
        () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(updatePosition);
        },
        { passive: true }
      );
      updatePosition();
    }
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
