---
import { Image, getImage } from 'astro:assets';
import { artistPayload, type ArtEntry } from '../lib/art';
import { stamp } from '../lib/format';

interface Props {
  entry: ArtEntry;
  artistCount?: number;
}

const { entry, artistCount = 1 } = Astro.props;
const d = entry.data;

const full = await getImage({ src: d.image, widths: [1600], format: 'webp' });

const credited = !!d.artist;
const hasCard = credited && d.artistLinks.length > 0;
const payload = hasCard ? artistPayload(d, artistCount) : undefined;
const label = d.artistHandle || d.artist || '';
const verb = d.commissioned ? 'Drawn by' : 'By';
---

<figure class="piece">
  <a
    class="piece__link brackets"
    href={full.src}
    data-piece
    data-title={d.title}
    data-alt={d.alt}
    data-full={full.src}
    data-medium={d.medium ?? ''}
    data-note={d.note ?? ''}
    data-commissioned={d.commissioned ? 'true' : ''}
    data-credit-pending={d.creditPending ? 'true' : ''}
    data-artist-label={credited ? `${verb} ${label}` : ''}
    data-artist-payload={payload ?? ''}
    data-date={d.date ? stamp(d.date) : ''}
  >
    <Image
      src={d.image}
      alt={d.alt}
      widths={[400, 700, 1000]}
      sizes="(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 30vw"
      loading="lazy"
    />
    <span class="piece__rule" aria-hidden="true"></span>
  </a>

  <figcaption class="piece__cap">
    <span class="piece__title">{d.title}</span>

    <span class="piece__meta">
      {d.medium && <span class="piece__medium data">{d.medium}</span>}

      {
        credited &&
          (hasCard ? (
            <button class="piece__credit data" type="button" data-artist={payload}>
              <span class="piece__credit-verb">{verb}</span>
              <span class="piece__credit-name">{label}</span>
            </button>
          ) : (
            <span class="piece__credit piece__credit--flat data">
              <span class="piece__credit-verb">{verb}</span>
              <span class="piece__credit-name">{label}</span>
            </span>
          ))
      }

      {
        d.creditPending && (
          <span class="piece__pending data" title="Add the artist to this piece's frontmatter">
            Credit pending
          </span>
        )
      }

      {d.sample && <span class="piece__sample stencil">Sample</span>}
    </span>
  </figcaption>
</figure>

<style>
  .piece {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .piece__link {
    --notch: var(--notch-m);
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--chassis-1);
    border: 1px solid var(--seam);
    clip-path: polygon(
      0 0,
      calc(100% - var(--notch)) 0,
      100% var(--notch),
      100% 100%,
      var(--notch) 100%,
      0 calc(100% - var(--notch))
    );
    transition: border-color var(--t-base) var(--ease-snap);
  }

  .piece__link:hover,
  .piece__link:focus-visible {
    border-color: rgb(46 123 255 / 0.5);
  }

  .piece__link::before,
  .piece__link::after {
    z-index: 1;
    opacity: 0;
    transition: opacity var(--t-base) var(--ease-snap);
  }

  .piece__link:hover::before,
  .piece__link:hover::after,
  .piece__link:focus-visible::before,
  .piece__link:focus-visible::after {
    opacity: 0.85;
  }

  .piece__link :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 12%;
    transition: transform var(--t-slow) var(--ease-power);
  }

  .piece__link:hover :global(img) {
    transform: scale(1.03);
  }

  .piece__rule {
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    background: linear-gradient(90deg, var(--led), var(--led-hot));
    box-shadow: var(--emit-led);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-slow) var(--ease-power);
  }

  .piece__link:hover .piece__rule,
  .piece__link:focus-visible .piece__rule {
    transform: scaleX(1);
  }

  .piece__cap {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding-block-start: var(--s3);
    margin-block-start: auto;
  }

  .piece__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .piece__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2) var(--s3);
    font-size: 0.6875rem;
  }

  .piece__medium {
    color: var(--ink-4);
  }

  .piece__credit {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 0;
    font-size: 0.6875rem;
    text-align: left;
    transition: color var(--t-fast) var(--ease-snap);
  }

  .piece__credit-verb {
    color: var(--ink-4);
  }

  .piece__credit-name {
    color: var(--sig);
    border-bottom: 1px solid rgb(255 212 41 / 0.4);
    transition: border-color var(--t-fast) var(--ease-snap);
  }

  .piece__credit--flat .piece__credit-name {
    border-bottom: none;
  }

  .piece__credit:hover .piece__credit-name,
  .piece__credit:focus-visible .piece__credit-name {
    border-bottom-color: var(--sig);
  }

  .piece__pending {
    color: var(--warn);
    background: rgb(255 165 2 / 0.1);
    border: 1px solid rgb(255 165 2 / 0.3);
    padding: 2px 7px;
  }

  .piece__sample {
    font-size: 0.5625rem;
    color: var(--warn);
  }

  @media (prefers-reduced-motion: reduce) {
    .piece__link:hover :global(img) {
      transform: none;
    }
  }
</style>
