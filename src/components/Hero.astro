---
import { Image } from 'astro:assets';
import Rain from './Rain.astro';
import hero from '../assets/hero.png';

let s = 0x2545f491;
const rand = () => {
  s ^= s << 13;
  s >>>= 0;
  s ^= s >>> 17;
  s ^= s << 5;
  s >>>= 0;
  return (s % 100000) / 100000;
};

const bokeh = Array.from({ length: 46 }, () => ({
  x: +(rand() * 1000).toFixed(1),
  y: +(rand() * 460).toFixed(1),
  r: +(2 + rand() * 9).toFixed(1),
  o: +(0.05 + rand() * 0.26).toFixed(2),
  warm: rand() > 0.6,
}));
---

<section class="hero" data-stage="pin" aria-labelledby="hero-title">
  <div class="hero__frame">
    <div class="scene" aria-hidden="true">
      <div class="scene__sky l-sky"></div>

      <svg class="scene__bokeh l-sky" viewBox="0 0 1000 560" preserveAspectRatio="xMidYMid slice">
        <defs>
          <radialGradient id="bokeh-cool">
            <stop offset="0%" stop-color="#8cbaff" stop-opacity="0.85" />
            <stop offset="45%" stop-color="#8cbaff" stop-opacity="0.3" />
            <stop offset="100%" stop-color="#8cbaff" stop-opacity="0" />
          </radialGradient>
          <radialGradient id="bokeh-warm">
            <stop offset="0%" stop-color="#ffd429" stop-opacity="0.8" />
            <stop offset="45%" stop-color="#ffd429" stop-opacity="0.28" />
            <stop offset="100%" stop-color="#ffd429" stop-opacity="0" />
          </radialGradient>
        </defs>
        {
          bokeh.map((b) => (
            <circle
              cx={b.x}
              cy={b.y}
              r={b.r * 2.6}
              fill={b.warm ? 'url(#bokeh-warm)' : 'url(#bokeh-cool)'}
              opacity={b.o * 1.6}
            />
          ))
        }
      </svg>

      <div class="scene__rain l-far"><Rain depth="far" /></div>
      <div class="scene__rain l-mid"><Rain depth="mid" /></div>
    </div>

    <div class="word l-word" aria-hidden="true">
      <img class="word__text" src="/brand-wordmark.svg" width="676" height="100" alt="" fetchpriority="high" />
      <p class="word__plate">
        <span class="word__tag stencil">MNM-01</span>
        <span class="word__line data">Field unit <span class="word__dia">◆</span> code · rhythm · art</span>
      </p>
    </div>

    <div class="hud brackets l-word" aria-hidden="true">
      <span class="hud__rail data">monumei.com <span class="word__dia">◆</span> sector 01 <span class="word__dia">◆</span> rain</span>
      <span class="hud__ticks"></span>
    </div>

    <div class="hero__scrim l-scrim" aria-hidden="true"></div>

    <div class="figure l-figure">
      <Image
        src={hero}
        alt=""
        widths={[520, 780, 1100]}
        sizes="(max-width: 720px) 92vw, (max-width: 1180px) 60vw, 46vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="scene scene--front" aria-hidden="true">
      <div class="scene__rain l-near"><Rain depth="near" /></div>
      <div class="scene__haze"></div>
      <div class="scene__film"></div>
    </div>

    <div class="hero__ui rail">
      <h1 class="sr-only" id="hero-title">Monumei: software, rhythm games, and art</h1>

      <div class="hero__copy l-copy">
        <p class="hero__role">
          <span class="hero__role-main">Founding Engineer</span>
        </p>

        <p class="hero__blurb">
          I mostly build the boring systems that can't afford to be wrong… money, tax,
          land records. Lately I've been putting small AI models where a bad guess
          actually costs something.
          Away from code, I play maimai and collect art of Monumei.
        </p>

        <div class="hero__actions">
          <a class="btn btn--primary" href="#log">Read the blog</a>
          <a class="btn btn--ghost" href="https://github.com/monumei" rel="me noopener">GitHub</a>
        </div>
      </div>

    </div>

    <div class="hero__cue" aria-hidden="true">
      <span class="hero__cue-label data">Scroll</span>
      <span class="hero__cue-rail"><span class="hero__cue-bead"></span></span>
    </div>
  </div>
</section>

<style>
  .hero {
    --p: 0;
    position: relative;
    height: 250vh;
    overflow: clip;
  }

  .hero__frame {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    background: #05070e;
    isolation: isolate;
  }

  .scene,
  .scene--front {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .scene--front {
    z-index: 4;
  }

  .scene__sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(58% 42% at 62% 12%, rgb(46 123 255 / 0.34), transparent 72%),
      radial-gradient(46% 34% at 16% 68%, rgb(112 84 200 / 0.2), transparent 76%),
      linear-gradient(180deg, #0c1730 0%, #080e1e 46%, #05070e 100%);
  }

  .scene__bokeh {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 62%;
    opacity: 0.85;
  }

  .scene__rain {
    position: absolute;
    inset: 0;
  }

  .scene__haze {
    position: absolute;
    inset: auto 0 0 0;
    height: 42%;
    background: linear-gradient(180deg, transparent, rgb(46 123 255 / 0.08) 46%, rgb(5 7 14 / 0.94));
  }

  .scene__film {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(0deg, transparent 0 3px, rgb(255 255 255 / 0.013) 3px 4px),
      radial-gradient(120% 92% at 50% 44%, transparent 52%, rgb(0 0 0 / 0.72) 100%);
  }

  .word {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(14px, 2.2vw, 28px);
    padding-inline-start: var(--gutter);
    padding-block-end: 22vh;
  }

  .word__text {
    display: block;
    width: min(72vw, 64rem);
    max-width: calc(100vw - var(--gutter) - var(--gutter));
    height: auto;
  }

  .word__plate {
    display: flex;
    align-items: stretch;
    gap: 12px;
    margin: 0;
    max-width: calc(100vw - var(--gutter) - var(--gutter));
  }

  .word__tag {
    display: grid;
    place-items: center;
    padding: 5px 14px 5px 10px;
    background: var(--sig);
    color: var(--void);
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--notch-s)) 100%, 0 100%);
  }

  .word__line {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-inline-start: 12px;
    border-inline-start: 1px solid var(--seam-bright);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .word__dia {
    font-size: 0.55em;
    color: var(--sig);
  }

  /* Hairline signage frame: the Endfield two-corner bracket, a mono rail on
     the left edge, and a tick ruler along the bottom. Sits behind the figure. */
  .hud {
    position: absolute;
    inset: calc(var(--gutter) + 52px) var(--gutter) var(--gutter);
    z-index: 2;
    pointer-events: none;
  }

  .hud__rail {
    position: absolute;
    left: -6px;
    bottom: 64px;
    transform: rotate(-90deg);
    transform-origin: left top;
    font-size: 0.625rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-4);
    white-space: nowrap;
  }

  .hud__ticks {
    position: absolute;
    left: 40px;
    bottom: 0;
    width: min(320px, 40%);
    height: 8px;
    background: repeating-linear-gradient(90deg, var(--seam-bright) 0 1px, transparent 1px 12px);
    border-bottom: 1px solid var(--seam-strong);
  }

  .figure {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    pointer-events: none;
    overflow: hidden;
  }

  .figure :global(img) {
    width: auto;
    height: 106%;
    max-width: none;
    margin-inline-end: -9%;
    margin-block-end: -4%;
    object-fit: contain;
    object-position: bottom right;
    -webkit-mask-image: linear-gradient(90deg, #000 78%, transparent 99%);
    mask-image: linear-gradient(90deg, #000 78%, transparent 99%);
  }

  .hero__ui {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 4vh, 40px);
    padding-block: clamp(60px, 12vh, 130px) clamp(80px, 17vh, 190px);
  }

  .hero__scrim {
    position: absolute;
    inset: auto 0 0 0;
    height: 78%;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgb(5 7 14 / 0) 0%,
      rgb(5 7 14 / 0.06) 22%,
      rgb(5 7 14 / 0.22) 40%,
      rgb(5 7 14 / 0.48) 56%,
      rgb(5 7 14 / 0.72) 72%,
      rgb(5 7 14 / 0.9) 100%
    );
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    max-width: 46ch;
  }

  .hero__role {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s3) var(--s4);
    margin: 0;
  }

  .hero__role-main {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.95rem, 1.6vw, 1.2rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .hero__blurb {
    font-size: 1.0625rem;
    line-height: 1.68;
    color: var(--ink-2);
    text-shadow: 0 1px 12px rgb(5 7 14 / 0.9);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-block-start: var(--s2);
  }

  .hero__cue {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(24px, 5vh, 52px);
    z-index: 6;
    display: flex;
    align-items: center;
    gap: var(--s3);
    opacity: calc(1 - clamp(0, calc((var(--p) - 0.1) * 7), 1));
  }

  .hero__cue-label {
    font-size: 0.5625rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ink-4);
  }

  .hero__cue-rail {
    position: relative;
    width: 46px;
    height: 1px;
    background: var(--chassis-4);
    overflow: hidden;
  }

  .hero__cue-bead {
    position: absolute;
    inset: 0 auto 0 0;
    width: 14px;
    background: var(--sig);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__cue-bead {
      animation: cue-run 2.6s var(--ease-power) infinite;
    }
  }

  @keyframes cue-run {
    0% {
      transform: translateX(-100%);
    }
    60%,
    100% {
      transform: translateX(330%);
    }
  }

  .l-sky {
    transform: translate3d(0, calc(var(--p) * 5vh), 0) scale(calc(1 + var(--p) * 0.06));
  }

  .l-far {
    transform: translate3d(0, calc(var(--p) * -4vh), 0);
  }

  .l-mid {
    transform: translate3d(0, calc(var(--p) * -9vh), 0);
  }

  .l-near {
    opacity: calc(0.55 + var(--p) * 0.45);
    transform: translate3d(0, calc(var(--p) * -20vh), 0) scale(calc(1 + var(--p) * 0.14));
  }

  .l-word {
    --e: clamp(0, calc((var(--p) - 0.5) * 2.4), 1);
    opacity: calc(1 - var(--e));
    transform: translate3d(0, calc(var(--e) * -14vh), 0) scale(calc(1 - var(--e) * 0.1));
    will-change: transform, opacity;
  }

  .l-figure {
    --e: clamp(0, calc((var(--p) - 0.62) * 2.8), 1);
    opacity: calc(1 - var(--e));
    transform: translate3d(0, calc(var(--e) * -7vh), 0) scale(calc(1 + var(--p) * 0.14));
    will-change: transform, opacity;
  }

  .l-copy {
    --r: clamp(0, calc((var(--p) - 0.16) * 4.4), 1);
    --e: clamp(0, calc((var(--p) - 0.7) * 3.6), 1);
    opacity: calc(var(--r) - var(--e));
    transform: translate3d(0, calc((1 - var(--r)) * 44px - var(--e) * 6vh), 0);
  }

  .l-scrim {
    opacity: clamp(0, calc((var(--p) - 0.12) * 5), 1);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .word__text {
      animation: word-resolve 1.1s var(--ease-seat) 120ms backwards;
    }

    :global(.js) .figure :global(img) {
      animation: figure-arrive 1.3s var(--ease-seat) 220ms backwards;
    }

  }

  @keyframes word-resolve {
    from {
      opacity: 0;
      transform: scale(1.03);
    }
  }

  @keyframes figure-arrive {
    from {
      opacity: 0;
      transform: translateY(5%) scale(1.04);
    }
  }

  @media (max-width: 1180px) {
    .figure :global(img) {
      height: 82%;
    }

    .word {
      justify-content: flex-start;
      padding-block-start: 16vh;
    }
  }

  @media (max-width: 860px), (max-height: 700px) {
    .hero {
      height: 210svh;
    }

    .hero__frame {
      position: sticky;
      height: 100svh;
      overflow: clip;
    }

    .hero__cue {
      display: none;
    }
  }

  @media (max-width: 720px) {
    /* The figure stays anchored to the bottom of the frame, as it is on
       desktop. Pinning it to the top at a fixed 62vh left the artwork ending
       a couple of hundred pixels short of the frame, and that hard horizontal
       edge against the background is what read as the figure being cut off. */
    .figure {
      align-items: flex-end;
    }

    /* Still tall enough that the artwork bleeds past both side edges — below
       roughly 65% it stops filling the width and its own frame edges show. */
    .figure :global(img) {
      height: 74%;
      margin-inline-end: -6%;
      margin-block-end: 0;
    }

    .word {
      justify-content: flex-start;
      padding-block-start: 18vh;
    }

    .word__text {
      width: calc(100vw - var(--gutter) - var(--gutter));
    }

    .word__line {
      font-size: 0.625rem;
      letter-spacing: 0.1em;
    }

    .hud__rail {
      display: none;
    }

    .l-sky,
    .l-far,
    .l-mid,
    .l-near,
    .l-word,
    .l-figure,
    .l-copy {
      filter: none;
    }
  }

  @media (max-height: 620px) {
    .hero {
      height: auto;
    }

    .hero__frame {
      position: static;
      min-height: 100svh;
    }

    .l-sky,
    .l-far,
    .l-mid,
    .l-near,
    .l-word,
    .l-figure,
    .l-copy {
      opacity: 1;
      filter: none;
      transform: none;
    }

  }
</style>
