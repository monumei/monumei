---

<script>
  type Mode = 'pin' | 'view';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  const active = new Set<HTMLElement>();
  const written = new WeakMap<HTMLElement, string>();
  const frames = new WeakMap<HTMLElement, { frame: HTMLElement | null; sticky: boolean }>();

  let io: IntersectionObserver | null = null;
  let queued = false;
  let bound = false;
  let lastScroll = '';

  const refresh = (stages: HTMLElement[]) => {
    for (const el of stages) {
      const frame = el.firstElementChild as HTMLElement | null;
      const sticky = !!frame && getComputedStyle(frame).position === 'sticky';
      frames.set(el, { frame, sticky });
    }
  };

  const viewProgress = (rect: DOMRect) => {
    const vh = window.innerHeight;
    return (vh - rect.top) / (vh + rect.height);
  };

  const measure = (el: HTMLElement) => {
    const mode = (el.dataset.stage as Mode) ?? 'view';
    const rect = el.getBoundingClientRect();

    let p: number;
    if (mode === 'pin') {
      const info = frames.get(el);
      if (info?.sticky && info.frame) {
        const travel = rect.height - info.frame.offsetHeight;
        p = travel > 0 ? -rect.top / travel : 0;
      } else {
        p = viewProgress(rect);
      }
    } else {
      p = viewProgress(rect);
    }

    p = p < 0 ? 0 : p > 1 ? 1 : p;
    const next = p.toFixed(3);
    if (written.get(el) === next) return;
    written.set(el, next);
    el.style.setProperty('--p', next);
  };

  const frame = () => {
    queued = false;
    for (const el of active) measure(el);

    const spine = document.querySelector<HTMLElement>('.spine');
    if (spine) {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const next = max > 0 ? (window.scrollY / max).toFixed(3) : '0';
      if (next !== lastScroll) {
        lastScroll = next;
        spine.style.setProperty('--scroll', next);
      }
    }
  };

  const schedule = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(frame);
  };

  const measureTracks = () => {
    for (const track of document.querySelectorAll<HTMLElement>('[data-track]')) {
      const travel = Math.max(0, track.scrollWidth - track.clientWidth);
      track.style.setProperty('--travel', `${travel}px`);
    }
  };

  const init = () => {
    const stages = [...document.querySelectorAll<HTMLElement>('[data-stage]')];

    io?.disconnect();
    io = null;
    active.clear();
    lastScroll = '';

    if (!stages.length) return;

    if (reduce.matches) {
      for (const el of stages) el.style.setProperty('--p', '1');
      return;
    }

    refresh(stages);

    io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;
          if (entry.isIntersecting) {
            active.add(el);
            measure(el);
          } else {
            active.delete(el);
            el.style.setProperty('--p', entry.boundingClientRect.top < 0 ? '1' : '0');
          }
        }
        schedule();
      },
      { threshold: 0 }
    );

    for (const el of stages) io.observe(el);

    const onResize = () => {
      refresh(stages);
      measureTracks();
      schedule();
    };

    if (!bound) {
      bound = true;
      addEventListener('scroll', schedule, { passive: true });
      addEventListener('resize', onResize, { passive: true });
      addEventListener('orientationchange', onResize);
      if (document.fonts?.ready) document.fonts.ready.then(onResize);
    }

    measureTracks();
    schedule();
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
