---
const systems = [
  {
    k: 'Software Engineering',
    v: 'Data, product, solutions — whichever the problem needs this week. Principal by title, generalist by habit.',
    head: 'In active use',
    tools: [
      'TypeScript',
      'React',
      'Next.js',
      'Tailwind',
      'Bun',
      'Elysia',
      'Vite',
      'Python',
      'discord.js',
    ],
  },
  {
    k: 'Art',
    v: 'Mostly Monumei, mostly commissioned from artists better at this than me. Some of it is actually mine.',
    head: 'Status',
    note: 'The gallery has the receipts.',
  },
  {
    k: 'Rhythm games',
    v: '15,000+ maimai plays and counting. Unfortunately a personality trait at this point.',
    head: 'Status',
    note: 'Still going.',
  },
];

const lines = [
  'M 0 120 H 340 L 400 180 H 760 L 820 120 H 1200 L 1260 180 H 1600',
  'M 0 300 H 200 L 268 232 H 620 L 690 300 H 1010 L 1080 232 H 1600',
  'M 0 470 H 430 L 500 540 H 900 L 970 470 H 1340 L 1400 540 H 1600',
  'M 0 660 H 250 L 320 590 H 700 L 770 660 H 1150 L 1220 590 H 1600',
  'M 0 820 H 520 L 590 750 H 980 L 1050 820 H 1600',
];
---

<section class="sys" data-stage="pin" data-loc="SYSTEMS" aria-labelledby="sys-h">
  <div class="sys__frame">
    <div class="sys__board" aria-hidden="true">
      <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="sys-trace" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#2e7bff" stop-opacity="0.05" />
            <stop offset="50%" stop-color="#7fb4ff" stop-opacity="0.5" />
            <stop offset="100%" stop-color="#2e7bff" stop-opacity="0.05" />
          </linearGradient>
        </defs>
        <g fill="none" stroke="url(#sys-trace)" stroke-width="1.5">
          {lines.map((d) => <path d={d} />)}
        </g>
        <g fill="#8cbaff" fill-opacity="0.5">
          {
            [
              [400, 180], [820, 120], [1260, 180], [268, 232], [690, 300],
              [1080, 232], [500, 540], [970, 470], [1400, 540], [320, 590],
              [770, 660], [1220, 590], [590, 750], [1050, 820],
            ].map(([cx, cy]) => <circle cx={cx} cy={cy} r="2.5" />)
          }
        </g>
      </svg>
    </div>
    <div class="sys__veil" aria-hidden="true"></div>

    <div class="sys__inner rail">
      <h2 class="sys__h" id="sys-h">What I actually do</h2>

      <ol class="sys__list" style={`--n:${systems.length}`}>
        {
          systems.map((s, i) => (
            <li class="sys__item" style={`--i:${i}`}>
              <span class="sys__rule" aria-hidden="true" />

              <div class="sys__text">
                <h3 class="sys__k">{s.k}</h3>
                <p class="sys__v">{s.v}</p>
              </div>

              <div class="sys__evidence">
                <p class="sys__evidence-h stencil">{s.head}</p>

                {s.tools ? (
                  <ul class="sys__tools">
                    {s.tools.map((t) => (
                      <li class="sys__tool">
                        <span class="sys__tool-glyph" aria-hidden="true" />
                        {t}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="sys__note">{s.note}</p>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .sys {
    --p: 0;
    position: relative;
    height: 300vh;
  }

  .sys__frame {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--chassis-0);
  }

  .sys__board {
    position: absolute;
    inset: -12%;
    opacity: calc(0.3 + var(--p) * 0.55);
    transform: translate3d(calc(var(--p) * -9%), 0, 0) scale(calc(1.05 + var(--p) * 0.22));
  }

  .sys__board svg {
    width: 100%;
    height: 100%;
  }

  .sys__veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(80% 70% at 22% 50%, rgb(46 123 255 / 0.16), transparent 70%),
      linear-gradient(90deg, rgb(12 14 17 / 0.97) 30%, rgb(12 14 17 / 0.72) 72%, rgb(12 14 17 / 0.86));
  }

  .sys__inner {
    position: relative;
    width: 100%;
  }

  .sys__h {
    font-size: clamp(0.8rem, 1.5vw, 0.95rem);
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-4);
    margin-block-end: clamp(24px, 4.5vh, 48px);
  }

  .sys__list {
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 3.4vh, 38px);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .sys__item {
    --l: calc(var(--p) * var(--n) - var(--i));
    --in: clamp(0, calc(var(--l) * 3.4), 1);
    --out: clamp(0, calc((var(--l) - 1) * 3.4), 1);
    --act: calc(var(--in) - var(--out));
    display: grid;
    grid-template-columns: 3px minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: start;
    gap: clamp(16px, 2.4vw, 34px);
    opacity: calc(0.14 + var(--act) * 0.86);
    transform: translate3d(calc((1 - var(--act)) * 26px), 0, 0);
  }

  .sys__rule {
    position: relative;
    align-self: stretch;
    background: var(--chassis-3);
    overflow: hidden;
  }

  .sys__rule::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--led-hot), var(--led));
    box-shadow: var(--emit-led);
    transform: scaleY(var(--in));
    transform-origin: top;
  }

  .sys__k {
    font-size: clamp(1.4rem, 3.2vw, 2.5rem);
    font-weight: 600;
    line-height: 1.04;
    margin-block-end: 0.35em;
    color: color-mix(in oklab, var(--ink-3), var(--ink) calc(var(--act) * 100%));
  }

  .sys__v {
    max-width: 46ch;
    font-size: clamp(0.9rem, 1.3vw, 1.0625rem);
    line-height: 1.6;
    color: var(--ink-3);
  }

  .sys__evidence {
    padding-block-start: 0.4em;
    opacity: calc(clamp(0, calc((var(--l) - 0.18) * 3.4), 1) - var(--out));
    transform: translate3d(calc((1 - var(--act)) * 14px), 0, 0);
  }

  .sys__evidence-h {
    color: var(--ink-4);
    padding-block-end: var(--s3);
    border-block-end: 1px solid var(--seam);
  }

  .sys__tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2) clamp(14px, 1.6vw, 26px);
    padding: 0;
    margin-block-start: var(--s4);
    list-style: none;
  }

  .sys__tool {
    display: flex;
    align-items: center;
    gap: var(--s2);
    font-family: var(--font-data);
    font-size: clamp(0.75rem, 1vw, 0.875rem);
    letter-spacing: 0.04em;
    color: var(--ink-2);
    white-space: nowrap;
  }

  .sys__tool-glyph {
    width: 4px;
    height: 4px;
    flex: none;
    background: var(--led);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
  }

  .sys__note {
    max-width: 34ch;
    margin-block-start: var(--s4);
    font-size: clamp(0.85rem, 1.1vw, 0.9375rem);
    line-height: 1.6;
    color: var(--sig-deep);
  }

  @media (max-width: 900px) {
    .sys__item {
      grid-template-columns: 3px minmax(0, 1fr);
    }

    .sys__evidence {
      grid-column: 2;
      transform: none;
    }
  }

  @media (max-width: 860px), (max-height: 700px) {
    .sys {
      height: 240svh;
    }

    .sys__frame {
      position: sticky;
      height: 100svh;
      padding-block: clamp(72px, 12svh, var(--s9));
      overflow: clip;
    }

    .sys__item {
      gap: var(--s3);
    }
  }

  @media (max-height: 620px) {
    .sys {
      height: auto;
    }

    .sys__frame {
      position: static;
      height: auto;
      padding-block: var(--s9);
    }

    .sys__item {
      --in: 1;
      --act: 1;
      opacity: 1;
      transform: none;
    }

    .sys__evidence {
      opacity: 1;
    }

    .sys__board {
      opacity: 0.35;
    }
  }
</style>
