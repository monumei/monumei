---
interface Props {
  depth: 'far' | 'mid' | 'near';
}

const { depth } = Astro.props;
---

<div class:list={['rain', `rain--${depth}`]} aria-hidden="true">
  <div class="rain__sheet"></div>
</div>

<style>
  .rain {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .rain__sheet {
    position: absolute;
    inset: -10% -10% auto;
    height: 220%;
    will-change: transform;
    transform: translate3d(0, -50%, 0);
    backface-visibility: hidden;
    -webkit-mask-image: var(--dash);
    mask-image: var(--dash);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rain__sheet {
      animation: rain-fall linear infinite;
    }
  }

  @keyframes rain-fall {
    from {
      transform: translate3d(0, -50%, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  .rain--far .rain__sheet {
    --dash: repeating-linear-gradient(11deg, #000 0 34px, transparent 34px 96px);
    opacity: 0.6;
    background-image:
      repeating-linear-gradient(
        101deg,
        transparent 0 31px,
        rgb(157 189 240 / 0.05) 31px 32px,
        rgb(157 189 240 / 0.13) 32px 33px,
        rgb(157 189 240 / 0.05) 33px 34px,
        transparent 34px 67px
      ),
      repeating-linear-gradient(
        101deg,
        transparent 0 47px,
        rgb(157 189 240 / 0.09) 47px 48px,
        transparent 48px 103px
      );
    animation-duration: 3.1s;
  }

  .rain--mid .rain__sheet {
    --dash: repeating-linear-gradient(10deg, #000 0 58px, transparent 58px 168px);
    opacity: 0.72;
    background-image:
      repeating-linear-gradient(
        100deg,
        transparent 0 53px,
        rgb(188 214 255 / 0.08) 53px 54px,
        rgb(188 214 255 / 0.26) 54px 55.5px,
        rgb(188 214 255 / 0.08) 55.5px 57px,
        transparent 57px 119px
      ),
      repeating-linear-gradient(
        100deg,
        transparent 0 83px,
        rgb(188 214 255 / 0.16) 83px 84.5px,
        transparent 84.5px 171px
      );
    animation-duration: 1.7s;
  }

  .rain--near .rain__sheet {
    --dash: repeating-linear-gradient(9deg, #000 0 90px, transparent 90px 300px);
    opacity: 0.8;
    background-image:
      repeating-linear-gradient(
        99deg,
        transparent 0 127px,
        rgb(223 234 255 / 0.06) 127px 129px,
        rgb(223 234 255 / 0.22) 129px 131.5px,
        rgb(223 234 255 / 0.06) 131.5px 134px,
        transparent 134px 271px
      ),
      repeating-linear-gradient(
        99deg,
        transparent 0 193px,
        rgb(223 234 255 / 0.13) 193px 195px,
        transparent 195px 389px
      );
    animation-duration: 0.95s;
  }
</style>
