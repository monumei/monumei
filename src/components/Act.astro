---
interface Props {
  id?: string;
  labelledby?: string;
  budget?: number;
  loc?: string;
  class?: string;
}

const { id, labelledby, budget = 80, loc, class: cls } = Astro.props;
---

<section
  class:list={['act', cls]}
  id={id}
  data-stage="pin"
  data-loc={loc}
  aria-labelledby={labelledby}
  style={`--budget:${budget}vh`}
>
  <div class="act__frame">
    <div class="act__inner rail">
      <slot />
    </div>
  </div>
</section>

<style>
  .act {
    --p: 0;
    position: relative;
    height: calc(100svh + var(--budget, 80vh));
  }

  .act__frame {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .act__inner {
    width: 100%;
    padding-block: 72px var(--s6);
  }

  @media (max-width: 860px), (max-height: 700px) {
    .act {
      height: auto;
    }

    .act__frame {
      position: static;
      height: auto;
      overflow: visible;
    }

    .act__inner {
      padding-block: var(--s8) var(--s7);
    }
  }
</style>
