---
interface Props {
  id?: string;
  labelledby?: string;
  loc?: string;
  class?: string;
}

const { id, labelledby, loc, class: cls } = Astro.props;
---

<section class:list={['act', cls]} id={id} data-loc={loc} aria-labelledby={labelledby}>
  <div class="act__inner rail">
    <slot />
  </div>
</section>

<style>
  .act {
    position: relative;
  }

  .act__inner {
    padding-block: clamp(96px, 16svh, 168px) clamp(64px, 10svh, 112px);
  }
</style>
