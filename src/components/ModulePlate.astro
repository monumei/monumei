---
/**
 * The heading plate for a section.
 *
 * It sticks under the nav while its own section scrolls beneath it, and is
 * pushed out of the way by the next section's plate. That is what stops the
 * lower half of the page reading as a stack of disconnected blocks: at any
 * moment you can see which module you are inside, and the handover from one
 * to the next is a visible event rather than a gap.
 *
 * `.plate` itself carries no transform — a transform here would fight the
 * sticky positioning — so the entrance motion lives on the inner row.
 */
interface Props {
  title: string;
  meta?: string;
  id?: string;
}

const { title, meta, id } = Astro.props;
---

<div class="plate">
  <div class="plate__row rise">
    <h2 class="plate__title" id={id}>{title}</h2>
    {meta && <span class="plate__meta data">{meta}</span>}
  </div>
  <div class="plate__channel led-channel"></div>
</div>

<style>
  /* The whole act pins now, so the plate travels with its content rather
     than sticking on its own. */
  .plate {
    margin-block-end: clamp(24px, 4vh, 44px);
  }

  .plate__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4) var(--s5);
    flex-wrap: wrap;
    padding-block-end: var(--s4);
  }

  .plate__title {
    font-size: clamp(1.85rem, 4.4vw, 3.1rem);
    font-weight: 600;
  }

  .plate__meta {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-4);
  }

  /* Fills with the section's own scroll progress — it is the same light as
     the spine, so it has to behave like it rather than snapping on. */
  .plate__channel {
    height: 2px;
  }

  .plate__channel::before {
    transition: none;
    transform: scaleX(clamp(0, calc((var(--p) - 0.04) * 3.2), 1));
  }

</style>
