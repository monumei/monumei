---
interface Props {
  title: string;
  meta?: string;
  id?: string;
  headingLevel?: 'h1' | 'h2';
}

const { title, meta, id, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<div class="plate">
  <div class="plate__row rise">
    <Heading class="plate__title" id={id}>{title}</Heading>
    {meta && <span class="plate__meta data">{meta}</span>}
  </div>
  <div class="plate__channel led-channel"></div>
</div>

<style>
  .plate {
    margin-block-end: clamp(24px, 4vh, 44px);
  }

  .plate__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4) var(--s5);
    flex-wrap: wrap;
    padding-block-end: var(--s4);
  }

  .plate__title {
    font-size: clamp(1.85rem, 4.4vw, 3.1rem);
    font-weight: 600;
  }

  .plate__meta {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-4);
  }

  .plate__channel {
    height: 2px;
  }

  .plate__channel::before {
    transition: none;
    transform: scaleX(clamp(0, calc((var(--p) - 0.04) * 3.2), 1));
  }

</style>
