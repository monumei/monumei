---
import { ROUTES } from '../lib/channels';

interface Props {
  location?: string;
}
const { location = 'ROOT' } = Astro.props;
const path = Astro.url.pathname;

const links = [
  ...ROUTES.map((r) => ({ href: r.href, label: r.label.replace(/^The /, ''), match: r.href.slice(0, -1) })),
  { href: '/#shell', label: 'Shell', match: null },
  { href: '/#channels', label: 'Contact', match: null },
];
---

<header class="isle" id="isle">
  <nav class="isle__pill" aria-label="Primary">
    <a class="isle__mark" href="/" aria-label="Monumei — home">
      <span class="isle__led" aria-hidden="true"></span>
      <span class="isle__name">MONUMEI</span>
    </a>

    <span class="isle__sep" aria-hidden="true"></span>

    <span class="isle__loc data" aria-hidden="true">
      <span id="nav-loc" data-home={location}>{location}</span>
    </span>

    <div class="isle__reveal">
      <ul class="isle__links">
        {
          links.map((l) => (
            <li>
              <a
                class="isle__link"
                href={l.href}
                aria-current={l.match && path.startsWith(l.match) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <button class="isle__toggle" type="button" aria-expanded="false" aria-controls="isle">
      <span class="sr-only">Show navigation</span>
      <span class="isle__chev" aria-hidden="true"></span>
    </button>
  </nav>
</header>

<style>
  .isle {
    position: fixed;
    inset: max(10px, env(safe-area-inset-top)) 0 auto 0;
    z-index: var(--z-nav);
    display: flex;
    justify-content: center;
    pointer-events: none;
    padding-inline: var(--s4);
  }

  .isle__pill {
    --spring: cubic-bezier(0.32, 1.3, 0.4, 1);
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--s3);
    max-width: 100%;
    padding: 7px 8px 7px 14px;
    background: rgb(9 10 13 / 0.94);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 999px;
    box-shadow: var(--lift-3);
    transition:
      gap var(--t-base) var(--spring),
      padding var(--t-base) var(--spring),
      border-color var(--t-base) var(--ease-snap),
      background var(--t-base) var(--ease-snap);
  }

  .isle__pill:hover,
  .isle__pill:focus-within,
  .isle[data-open] .isle__pill {
    border-color: rgb(255 255 255 / 0.18);
    background: rgb(11 13 17 / 0.97);
  }

  .isle__mark {
    display: flex;
    align-items: center;
    gap: 9px;
    flex: none;
    color: var(--ink);
  }

  .isle__led {
    width: 9px;
    height: 9px;
    flex: none;
    background: var(--led);
    box-shadow: 0 0 10px var(--led);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
    transition: background var(--t-fast) var(--ease-snap);
  }

  .isle__mark:hover .isle__led {
    background: var(--sig);
    box-shadow: 0 0 10px var(--sig);
  }

  .isle__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    white-space: nowrap;
  }

  .isle__sep {
    width: 1px;
    height: 14px;
    flex: none;
    background: rgb(255 255 255 / 0.14);
  }

  .isle__loc {
    flex: none;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    color: var(--sig);
    white-space: nowrap;
    overflow: hidden;
    max-width: 12ch;
    transition:
      width var(--t-base) var(--spring),
      max-width var(--t-base) var(--spring),
      opacity var(--t-fast) var(--ease-snap),
      margin var(--t-base) var(--spring);
  }

  /* The readout swaps text as you scroll between sections. Cutting straight
     from one word to the next reads as a glitch at this size, so the label
     lifts out and drops back in around the change. */
  .isle__loc > span {
    display: inline-block;
    transition:
      opacity var(--t-fast) var(--ease-snap),
      transform var(--t-fast) var(--ease-snap);
  }

  .isle__loc[data-swapping] > span {
    opacity: 0;
    transform: translateY(-4px);
  }

  .isle__reveal {
    display: grid;
    grid-template-columns: minmax(0, 0fr);
    transition: grid-template-columns var(--t-base) var(--spring);
  }

  .isle__links {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.4vw, 18px);
    min-width: 0;
    padding: 0;
    margin: 0;
    list-style: none;
    overflow: hidden;
  }

  .isle__link {
    display: block;
    padding: 4px 2px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
    opacity: 0;
    transition:
      color var(--t-fast) var(--ease-snap),
      opacity var(--t-fast) var(--ease-snap);
  }

  .isle__link:hover,
  .isle__link[aria-current='page'] {
    color: var(--sig);
  }

  .isle__pill:hover .isle__reveal,
  .isle__pill:focus-within .isle__reveal,
  .isle[data-open] .isle__pill .isle__reveal {
    grid-template-columns: minmax(0, 1fr);
  }

  .isle__pill:hover .isle__link,
  .isle__pill:focus-within .isle__link,
  .isle[data-open] .isle__pill .isle__link {
    opacity: 1;
    transition-delay: 90ms;
  }

  .isle__pill:hover .isle__loc,
  .isle__pill:focus-within .isle__loc,
  .isle[data-open] .isle__pill .isle__loc {
    max-width: 0;
    opacity: 0;
    margin-inline-end: calc(var(--s3) * -1);
  }

  .isle__toggle {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    transition: background var(--t-fast) var(--ease-snap);
  }

  .isle__toggle:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .isle__chev {
    width: 7px;
    height: 7px;
    border-right: 1.5px solid var(--ink-2);
    border-bottom: 1.5px solid var(--ink-2);
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--t-base) var(--spring);
  }

  .isle__toggle[aria-expanded='true'] .isle__chev {
    transform: translateY(1px) rotate(-135deg);
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 721px) {
    .isle__toggle {
      display: none;
    }
  }

  @media (max-width: 720px) {
    /* The capsule hugs its own row. The sheet is taken out of flow entirely —
       as a flex item with flex-basis:100% it forced the closed capsule ~90px
       wider than its contents, which is where the dead space came from. */
    .isle__pill {
      position: relative;
      flex-wrap: nowrap;
      border-radius: 999px;
      padding: 7px 8px 7px 14px;
    }

    .isle__reveal {
      position: absolute;
      top: calc(100% + 7px);
      left: 0;
      right: 0;
      grid-template-columns: 1fr;
      /* minmax(0,…), not a bare 0fr: an fr track's automatic minimum is
         min-content, so the sheet's own padding and border kept the closed
         track 18px tall — a stray black bar hanging under the capsule. */
      grid-template-rows: minmax(0, 0fr);
      overflow: hidden;
      transition: grid-template-rows var(--t-slow) var(--spring);
    }

    .isle[data-open] .isle__pill .isle__reveal {
      grid-template-rows: minmax(0, 1fr);
    }

    /* Background lives on the inner item so the 0fr track clips it away
       completely when closed — a border on the reveal itself would still
       draw a hairline. */
    .isle__links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      min-height: 0;
      margin: 0;
      padding: var(--s2) 0;
      background: rgb(9 10 13);
      border: 1px solid rgb(255 255 255 / 0.12);
      border-radius: 18px;
      box-shadow: var(--lift-3);
      overflow: hidden;
    }

    .isle__link {
      padding: 12px var(--s4);
    }

    /* The readout stays put on mobile: the sheet opens below rather than
       taking the capsule's width, so nothing needs to make room for it. */
    .isle__pill:hover .isle__loc,
    .isle__pill:focus-within .isle__loc,
    .isle[data-open] .isle__pill .isle__loc {
      max-width: 12ch;
      opacity: 1;
      margin-inline-end: 0;
    }

    .isle:not([data-open]) .isle__pill:hover .isle__reveal {
      grid-template-rows: minmax(0, 0fr);
    }

    .isle:not([data-open]) .isle__pill:hover .isle__link {
      opacity: 0;
    }

    .isle[data-open] .isle__pill .isle__link {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .isle__pill,
    .isle__reveal,
    .isle__loc,
    .isle__chev {
      transition-duration: 1ms;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let swapTimer = 0;
  let releaseTimer = 0;

  const setOpen = (toggle: HTMLButtonElement, open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    const label = toggle.querySelector('.sr-only');
    if (label) label.textContent = open ? 'Hide navigation' : 'Show navigation';

    const isle = toggle.closest<HTMLElement>('.isle');
    if (!isle) return;
    if (open) isle.dataset.open = '';
    else delete isle.dataset.open;
  };

  const currentToggle = () => document.querySelector<HTMLButtonElement>('.isle__toggle');

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const toggle = currentToggle();
    if (!toggle) return;

    if (target.closest('.isle__toggle')) {
      setOpen(toggle, toggle.getAttribute('aria-expanded') !== 'true');
      return;
    }

    if (target.closest('.isle__link') || !target.closest('.isle__pill')) {
      setOpen(toggle, false);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const toggle = currentToggle();
    if (toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(toggle, false);
      toggle.focus();
    }
  });

  let io: IntersectionObserver | null = null;

  const init = () => {
    const loc = document.getElementById('nav-loc');

    io?.disconnect();
    io = null;

    if (!loc) return;
    const home = loc.dataset.home ?? 'ROOT';
    const sections = [...document.querySelectorAll<HTMLElement>('[data-loc]')];
    if (!sections.length) return;

    const visible = new Set<HTMLElement>();

    const paint = () => {
      let best: HTMLElement | null = null;
      for (const el of visible) {
        if (!best || el.getBoundingClientRect().top > best.getBoundingClientRect().top) {
          best = el;
        }
      }
      const next = best?.dataset.loc || home;
      if (next === loc.textContent) return;

      const wrap = loc.parentElement;
      if (!wrap || reduceMotion.matches) {
        loc.textContent = next;
        return;
      }

      // Pin the slot to its current width first, so swapping a short label for
      // a long one animates the capsule open instead of snapping it. The pill
      // itself is auto-width, so widening this slot carries the whole island.
      clearTimeout(swapTimer);
      clearTimeout(releaseTimer);
      wrap.style.width = `${loc.offsetWidth}px`;
      wrap.setAttribute('data-swapping', '');

      swapTimer = window.setTimeout(() => {
        loc.textContent = next;
        wrap.style.width = `${loc.offsetWidth}px`;
        wrap.removeAttribute('data-swapping');

        // Hand the slot back to auto once it has settled, so a viewport
        // resize can still re-fit it.
        releaseTimer = window.setTimeout(() => {
          wrap.style.width = '';
        }, 420);
      }, 140);
    };

    io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;
          if (entry.isIntersecting) visible.add(el);
          else visible.delete(el);
        }
        paint();
      },
      { rootMargin: '-88px 0px -78% 0px' }
    );

    for (const el of sections) io.observe(el);
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
