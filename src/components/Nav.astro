---
import { ROUTES } from '../lib/channels';

/**
 * The island.
 *
 * A floating capsule rather than a full-width bar: collapsed it shows the mark
 * and the module you are currently in, and it morphs open — width, not just
 * opacity — to reveal the routes. Hover or focus on a pointer device, tap on
 * touch.
 *
 * **This is the one place the site breaks its own zero-radius rule.** Every
 * other surface is chamfered; a Dynamic Island that is not a capsule is not a
 * Dynamic Island, and the owner asked for that specific feel. The chamfer still
 * shows up in the LED diamond and the focus ring, so it does not read as a
 * component borrowed from another site.
 *
 * The morph uses a grid `0fr → 1fr` track rather than animating `width` to a
 * measured pixel value: it stays smooth, needs no JS measurement, and reflows
 * correctly when the label inside changes length.
 *
 * No backdrop-filter. The island floats over art that repaints every frame,
 * which is the worst case for it; a near-opaque fill reads the same here.
 */
interface Props {
  location?: string;
}
const { location = 'ROOT' } = Astro.props;
const path = Astro.url.pathname;

const links = [
  ...ROUTES.map((r) => ({ href: r.href, label: r.label.replace(/^The /, ''), match: r.href.slice(0, -1) })),
  { href: '/#shell', label: 'Shell', match: null },
  { href: '/#channels', label: 'Contact', match: null },
];
---

<header class="isle" id="isle">
  <nav class="isle__pill" aria-label="Primary">
    <a class="isle__mark" href="/" aria-label="Monumei — home">
      <span class="isle__led" aria-hidden="true"></span>
      <span class="isle__name">MONUMEI</span>
    </a>

    <span class="isle__sep" aria-hidden="true"></span>

    {/* Collapsed readout: which module you are in. Swaps out as the panel
        opens, so the capsule never shows both at once. */}
    <span class="isle__loc data" aria-hidden="true">
      <span id="nav-loc" data-home={location}>{location}</span>
    </span>

    <div class="isle__reveal">
      <ul class="isle__links">
        {
          links.map((l) => (
            <li>
              <a
                class="isle__link"
                href={l.href}
                aria-current={l.match && path.startsWith(l.match) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <button class="isle__toggle" type="button" aria-expanded="false" aria-controls="isle">
      <span class="sr-only">Show navigation</span>
      <span class="isle__chev" aria-hidden="true"></span>
    </button>
  </nav>
</header>

<style>
  .isle {
    position: fixed;
    inset: max(10px, env(safe-area-inset-top)) 0 auto 0;
    z-index: var(--z-nav);
    display: flex;
    justify-content: center;
    pointer-events: none;
    padding-inline: var(--s4);
  }

  .isle__pill {
    --spring: cubic-bezier(0.32, 1.3, 0.4, 1);
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--s3);
    max-width: 100%;
    padding: 7px 8px 7px 14px;
    background: rgb(9 10 13 / 0.94);
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: 999px;
    box-shadow: var(--lift-3);
    transition:
      gap var(--t-base) var(--spring),
      padding var(--t-base) var(--spring),
      border-color var(--t-base) var(--ease-snap),
      background var(--t-base) var(--ease-snap);
  }

  .isle__pill:hover,
  .isle__pill:focus-within,
  .isle[data-open] .isle__pill {
    border-color: rgb(255 255 255 / 0.18);
    background: rgb(11 13 17 / 0.97);
  }

  /* ── Mark ─────────────────────────────────────────────────────────────── */

  .isle__mark {
    display: flex;
    align-items: center;
    gap: 9px;
    flex: none;
    color: var(--ink);
  }

  /* The chamfer survives here: the capsule is the borrowed shape, the diamond
     is the site's own. */
  .isle__led {
    width: 9px;
    height: 9px;
    flex: none;
    background: var(--led);
    box-shadow: 0 0 10px var(--led);
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
    transition: background var(--t-fast) var(--ease-snap);
  }

  .isle__mark:hover .isle__led {
    background: var(--sig);
    box-shadow: 0 0 10px var(--sig);
  }

  .isle__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    white-space: nowrap;
  }

  .isle__sep {
    width: 1px;
    height: 14px;
    flex: none;
    background: rgb(255 255 255 / 0.14);
  }

  /* ── Collapsed readout ────────────────────────────────────────────────── */

  .isle__loc {
    flex: none;
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    color: var(--sig);
    white-space: nowrap;
    overflow: hidden;
    max-width: 12ch;
    transition:
      max-width var(--t-base) var(--spring),
      opacity var(--t-fast) var(--ease-snap),
      margin var(--t-base) var(--spring);
  }

  /* ── The morph ────────────────────────────────────────────────────────────
     A 0fr → 1fr grid track: the panel animates its own width without anyone
     measuring it, and re-animates correctly if the link set changes.
     ──────────────────────────────────────────────────────────────────────── */

  .isle__reveal {
    display: grid;
    grid-template-columns: 0fr;
    transition: grid-template-columns var(--t-base) var(--spring);
  }

  .isle__links {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.4vw, 18px);
    min-width: 0;
    padding: 0;
    margin: 0;
    list-style: none;
    overflow: hidden;
  }

  .isle__link {
    display: block;
    padding: 4px 2px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
    opacity: 0;
    transition:
      color var(--t-fast) var(--ease-snap),
      opacity var(--t-fast) var(--ease-snap);
  }

  .isle__link:hover,
  .isle__link[aria-current='page'] {
    color: var(--sig);
  }

  /* Open: the routes take their width, the readout gives up its own. */
  .isle__pill:hover .isle__reveal,
  .isle__pill:focus-within .isle__reveal,
  .isle[data-open] .isle__pill .isle__reveal {
    grid-template-columns: 1fr;
  }

  .isle__pill:hover .isle__link,
  .isle__pill:focus-within .isle__link,
  .isle[data-open] .isle__pill .isle__link {
    opacity: 1;
    transition-delay: 90ms;
  }

  .isle__pill:hover .isle__loc,
  .isle__pill:focus-within .isle__loc,
  .isle[data-open] .isle__pill .isle__loc {
    max-width: 0;
    opacity: 0;
    margin-inline-end: calc(var(--s3) * -1);
  }

  /* ── Toggle ───────────────────────────────────────────────────────────── */

  .isle__toggle {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.06);
    transition: background var(--t-fast) var(--ease-snap);
  }

  .isle__toggle:hover {
    background: rgb(255 255 255 / 0.12);
  }

  .isle__chev {
    width: 7px;
    height: 7px;
    border-right: 1.5px solid var(--ink-2);
    border-bottom: 1.5px solid var(--ink-2);
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--t-base) var(--spring);
  }

  .isle__toggle[aria-expanded='true'] .isle__chev {
    transform: translateY(1px) rotate(-135deg);
  }

  /* On a wide pointer device hover already opens it, so the button is
     redundant chrome. The width clause is load-bearing: below 720px the sheet
     layout deliberately ignores hover, so hiding the button on a narrow desktop
     window too would leave no way at all to open the nav. */
  @media (hover: hover) and (pointer: fine) and (min-width: 721px) {
    .isle__toggle {
      display: none;
    }
  }

  /* ── Narrow ───────────────────────────────────────────────────────────────
     The capsule can't hold five routes on a phone, so opening drops them into
     a stacked sheet under the mark — still one object, still morphing.
     ──────────────────────────────────────────────────────────────────────── */

  @media (max-width: 720px) {
    .isle__pill {
      flex-wrap: wrap;
      border-radius: 22px;
      padding: 7px 8px 7px 14px;
    }

    /* Opaque once open: the sheet covers the page rather than ghosting the
       headings behind it. Selector deliberately mirrors the shape of the
       hover/focus rule above — a shorter one loses to it on specificity even
       though it comes later. */
    .isle[data-open] .isle__pill {
      background: rgb(9 10 13);
    }

    /* Same 0fr → 1fr trick as the desktop width, on the row axis. Animating
       max-height would thrash layout and needs a magic number tall enough for
       the longest sheet; a grid track just measures itself. */
    .isle__reveal {
      order: 4;
      flex-basis: 100%;
      grid-template-columns: 1fr;
      grid-template-rows: 0fr;
      /* The sheet's own border and padding still occupy the collapsed track,
         so the container clips them; without this the capsule keeps a ~25px
         sliver of empty sheet while closed. */
      overflow: hidden;
      transition: grid-template-rows var(--t-base) var(--ease-power);
    }

    .isle[data-open] .isle__pill .isle__reveal {
      grid-template-rows: 1fr;
    }

    /* Bare: padding, margin and border on the grid item itself survive a 0fr
       track (min-height only frees the content box), which left a 25px sliver
       of open sheet while closed. The spacing lives on the children instead,
       where overflow: hidden can clip it away. */
    .isle__links {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      min-height: 0;
      padding: 0;
      margin: 0;
      border: 0;
      overflow: hidden;
    }

    .isle__link {
      padding: 11px var(--s3);
    }

    .isle__links > li:first-child .isle__link {
      margin-block-start: var(--s2);
      border-block-start: 1px solid rgb(255 255 255 / 0.1);
      padding-block-start: 15px;
    }

    .isle__links > li:last-child .isle__link {
      padding-block-end: 15px;
    }

    /* Hover must not open the sheet on touch — only the button does. */
    .isle:not([data-open]) .isle__pill:hover .isle__reveal {
      grid-template-rows: 0fr;
    }

    .isle[data-open] .isle__reveal {
      grid-template-rows: 1fr;
    }

    .isle:not([data-open]) .isle__pill:hover .isle__link {
      opacity: 0;
    }

    .isle[data-open] .isle__pill .isle__link {
      opacity: 1;
    }

    .isle:not([data-open]) .isle__pill:hover .isle__loc {
      max-width: 12ch;
      opacity: 1;
      margin-inline-end: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .isle__pill,
    .isle__reveal,
    .isle__loc,
    .isle__chev {
      transition-duration: 1ms;
    }
  }
</style>

<script>
  // ── Open / close ────────────────────────────────────────────────────────
  // Delegated from the document and bound exactly once, for two reasons: this
  // module's init runs both at evaluation and on `astro:page-load`, so binding
  // straight to the button attached two handlers that cancelled each other out;
  // and view transitions replace the header wholesale, which would strand any
  // direct reference anyway.

  // The open state is a `data-open` attribute on the header, not a `:has()`
  // test against the button's aria-expanded. Both express the same thing, but
  // engines do not reliably re-run style invalidation for `:has()` when the
  // attribute it inspects is mutated — the selector matched on query and the
  // capsule stayed shut. An attribute on the styled element itself always
  // invalidates.
  const setOpen = (toggle: HTMLButtonElement, open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    const label = toggle.querySelector('.sr-only');
    if (label) label.textContent = open ? 'Hide navigation' : 'Show navigation';

    const isle = toggle.closest<HTMLElement>('.isle');
    if (!isle) return;
    if (open) isle.dataset.open = '';
    else delete isle.dataset.open;
  };

  const currentToggle = () => document.querySelector<HTMLButtonElement>('.isle__toggle');

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const toggle = currentToggle();
    if (!toggle) return;

    if (target.closest('.isle__toggle')) {
      setOpen(toggle, toggle.getAttribute('aria-expanded') !== 'true');
      return;
    }

    // Following a link, or clicking anywhere outside the capsule, closes it.
    if (target.closest('.isle__link') || !target.closest('.isle__pill')) {
      setOpen(toggle, false);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const toggle = currentToggle();
    if (toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(toggle, false);
      toggle.focus();
    }
  });

  // ── The readout ─────────────────────────────────────────────────────────
  let io: IntersectionObserver | null = null;

  const init = () => {
    const loc = document.getElementById('nav-loc');

    // Names the module currently under the island. Sections opt in by carrying
    // data-loc; pages without any keep the route's own label.
    io?.disconnect();
    io = null;

    if (!loc) return;
    const home = loc.dataset.home ?? 'ROOT';
    const sections = [...document.querySelectorAll<HTMLElement>('[data-loc]')];
    if (!sections.length) return;

    const visible = new Set<HTMLElement>();

    const paint = () => {
      let best: HTMLElement | null = null;
      for (const el of visible) {
        if (!best || el.getBoundingClientRect().top > best.getBoundingClientRect().top) {
          best = el;
        }
      }
      loc.textContent = best?.dataset.loc || home;
    };

    io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;
          if (entry.isIntersecting) visible.add(el);
          else visible.delete(el);
        }
        paint();
      },
      { rootMargin: '-88px 0px -78% 0px' }
    );

    for (const el of sections) io.observe(el);
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
