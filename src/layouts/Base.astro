---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ScrollEngine from '../components/ScrollEngine.astro';
import { serializeSchema, type JsonLdNode } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  location?: string;
  canonical?: boolean;
  index?: boolean;
  socialImage?: string;
  openGraphType?: 'website' | 'article';
  article?: {
    publishedTime: string;
    section: string;
    tags: string[];
  };
  schema?: JsonLdNode[];
}

const {
  title,
  description,
  location = 'ROOT',
  canonical: hasCanonical = true,
  index = true,
  openGraphType = 'website',
  socialImage = '/social-site.png',
  article,
  schema = [],
} = Astro.props;
const canonical = hasCanonical ? new URL(Astro.url.pathname, Astro.site) : undefined;
const socialImageUrl = new URL(socialImage, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!index && <meta name="robots" content="noindex,follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08090b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Monumei | Blog" href="/rss.xml" />

    {
      canonical && (
        <>
          <meta property="og:type" content={openGraphType} />
          <meta property="og:site_name" content="Monumei" />
          <meta property="og:locale" content="en_US" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:image" content={socialImageUrl} />
          <meta property="og:image:alt" content={title} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          {article && (
            <>
              <meta property="article:published_time" content={article.publishedTime} />
              <meta property="article:section" content={article.section} />
              {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
            </>
          )}
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:creator" content="@m0numei" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={socialImageUrl} />
          <meta name="twitter:image:alt" content={title} />
        </>
      )
    }

    {index && schema.length > 0 && <script type="application/ld+json" set:html={serializeSchema(schema)} />}

    <ClientRouter />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="chassis-grain" aria-hidden="true" transition:persist></div>
    <div class="grain" aria-hidden="true" transition:persist></div>
    <div class="spine" aria-hidden="true" transition:persist></div>
    <ScrollEngine />

    <Nav location={location} />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
