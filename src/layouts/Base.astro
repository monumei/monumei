---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ScrollEngine from '../components/ScrollEngine.astro';

interface Props {
  title: string;
  description: string;
  location?: string;
}

const { title, description, location = 'ROOT' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08090b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Monumei — The Log" href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@m0numei" />

    <ClientRouter />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="chassis-grain" aria-hidden="true" transition:persist></div>
    <div class="grain" aria-hidden="true" transition:persist></div>
    <div class="spine" aria-hidden="true" transition:persist></div>
    <ScrollEngine />

    <Nav location={location} />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
