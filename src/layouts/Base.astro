---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ScrollEngine from '../components/ScrollEngine.astro';

interface Props {
  title: string;
  description: string;
  /** Shown in the nav readout as the current module. */
  location?: string;
}

const { title, description, location = 'ROOT' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08090b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Monumei — The Log" href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@m0numei" />

    {/* Cross-page navigation as a cut rather than a reload. The persistent
        chrome — spine, grain, nav — survives the transition, which is what
        makes the site read as one object instead of five documents. */}
    <ClientRouter />

    <script is:inline>
      // Set before paint so the reveal system never flashes hidden content
      // for anyone who has JS disabled.
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <!--
      DIRECTION CONTRACT — monumei.com

      THESIS: This portfolio is a piece of gaming hardware, not a page about a
      person. It refuses the dark-portfolio default of near-black plus one neon
      accent plus glowing edges.

      OWN-WORLD: Neutral anodized graphite chassis (0% saturation) with machined
      seams and chamfered Endfield notches. Blue is LIGHT — diffused through
      frosted acrylic in recessed LED channels — never tinted into the metal.
      Signal yellow is PRINTED signage. Saira display, Chakra Petch body,
      JetBrains Mono for readouts only.

      STORY: One continuous camera move through a machine. Motion is SCRUBBED
      against scroll position via a single `--p` per stage — never fired once on
      entry — so pinned frames hold while their layers separate at different
      rates. An LED spine tracks whole-document progress across every act.

      FIRST VIEWPORT: Full-bleed chassis. Oversized MONUMEI wordmark left, LED
      spine filling down the left edge, spec plate rising as the wordmark
      recedes and defocuses, primary action on the plate's baseline.

      STRUCTURE: Each fact is stated once. Systems owns what Monumei does; the
      Log, the rack and the gallery are real routes with real collections
      behind them, not homepage anchors. Nothing is repeated for volume.

      FORM: Brief-pinned world (RGX 11z Pro blue + Arknights Endfield). No
      concept roll — a pinned direction beats the roll.

      FINISH: unreviewed and undocumented is unfinished; this build ends with the
      finish review, the verdict, and DESIGN.md
    -->

    <a class="skip-link" href="#main">Skip to content</a>
    <div class="chassis-grain" aria-hidden="true" transition:persist></div>
    <div class="grain" aria-hidden="true" transition:persist></div>
    <div class="spine" aria-hidden="true" transition:persist></div>
    <ScrollEngine />

    <Nav location={location} />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
