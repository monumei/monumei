---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ModulePlate from '../../components/ModulePlate.astro';
import WorkUnit from '../../components/WorkUnit.astro';
import EmptyBay from '../../components/EmptyBay.astro';

const units = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.unit - b.data.unit
);
---

<Base
  title="Selected Work | Monumei"
  description="Software projects built across product, data, infrastructure, and interface work."
  location="WORK"
>
  <div class="page rail">
    <ModulePlate
      title="Selected Work"
      meta={units.length ? `${units.length} ${units.length === 1 ? 'project' : 'projects'}` : undefined}
    />

    {
      units.length ? (
        <div class="deck page__grid" data-stage="view">
          {units.map((u) => (
            <WorkUnit
              href={`/work/${u.id}/`}
              unit={u.data.unit}
              title={u.data.title}
              summary={u.data.summary}
              tech={u.data.tech}
              status={u.data.status}
              stack={u.data.stack}
              sample={u.data.sample}
            />
          ))}
        </div>
      ) : (
        <EmptyBay
          label="No modules installed"
          hint="No projects yet. Add one Markdown file for each project."
          path="src/content/work/*.md"
        />
      )
    }
  </div>
</Base>

<style>
  .page {
    padding-block: clamp(118px, 15vh, 156px) var(--s8);
  }

  .page__grid {
    display: grid;
    gap: var(--s4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));
  }
</style>
