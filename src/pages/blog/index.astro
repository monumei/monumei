---
import Base from '../../layouts/Base.astro';
import ModulePlate from '../../components/ModulePlate.astro';
import LogEntry from '../../components/LogEntry.astro';
import ChannelBar from '../../components/ChannelBar.astro';
import EmptyBay from '../../components/EmptyBay.astro';
import { getPosts, channelCounts } from '../../lib/log';

const posts = await getPosts();
const counts = channelCounts(posts);
---

<Base
  title="Software, rhythm games, and art notes | Monumei"
  description="Notes on software, products, databases, design, art, events, and rhythm games."
  location="LOG"
>
  <div class="page rail">
    <ModulePlate
      title="Blog"
      headingLevel="h1"
      meta={posts.length ? `${posts.length} ${posts.length === 1 ? 'post' : 'posts'}` : undefined}
    />

    <ChannelBar counts={counts} total={posts.length} />

    {
      posts.length ? (
        <div class="deck ledger" data-stage="view">
          {posts.map((p) => (
            <LogEntry
              href={`/blog/${p.id}/`}
              title={p.data.title}
              summary={p.data.summary}
              channel={p.data.channel}
              date={p.data.date}
              sample={p.data.sample}
            />
          ))}
        </div>
      ) : (
        <EmptyBay
          label="Blog empty"
          hint="No posts yet. Add a Markdown file to publish the first one."
          path="src/content/blog/*.md"
        />
      )
    }
  </div>
</Base>

<style>
  .page {
    padding-block: clamp(118px, 15vh, 156px) var(--s8);
  }
</style>
