---
import Base from '../../layouts/Base.astro';
import ModulePlate from '../../components/ModulePlate.astro';
import LogEntry from '../../components/LogEntry.astro';
import ChannelBar from '../../components/ChannelBar.astro';
import EmptyBay from '../../components/EmptyBay.astro';
import { getPosts, channelCounts } from '../../lib/log';

const posts = await getPosts();
const counts = channelCounts(posts);
---

<Base
  title="The Log — Monumei"
  description="Writing by Monumei on fullstack engineering, cloud, design, conventions, and the occasional rhythm-game tangent."
  location="LOG"
>
  <div class="page rail">
    <ModulePlate
      title="The Log"
      meta={posts.length ? `${posts.length} ${posts.length === 1 ? 'entry' : 'entries'}` : undefined}
    />

    <ChannelBar counts={counts} total={posts.length} />

    {
      posts.length ? (
        <div class="deck ledger" data-stage="view">
          {posts.map((p) => (
            <LogEntry
              href={`/blog/${p.id}/`}
              title={p.data.title}
              summary={p.data.summary}
              channel={p.data.channel}
              date={p.data.date}
              sample={p.data.sample}
            />
          ))}
        </div>
      ) : (
        <EmptyBay
          label="Log buffer empty"
          hint="No entries written yet. Drop a markdown file in the blog collection and it appears here."
          path="src/content/blog/*.md"
        />
      )
    }
  </div>
</Base>

<style>
  /* The nav is fixed, so an index page has to open below it or its heading
     plate lands underneath the bar. */
  .page {
    padding-block: clamp(118px, 15vh, 156px) var(--s8);
  }
</style>
